# ------------------------------
# Dependencies
# ------------------------------
node_modules/
**/node_modules/

# ------------------------------
# Build outputs
# ------------------------------
dist/
build/
.vite/
**/.vite/

# ------------------------------
# Environment & secrets
# Keep required public frontend config in source (do not ignore that file)
# ------------------------------
.env
.env.*
**/.env
**/.env.*

# Common secret/key material
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
*.keystore

# Service account / credentials files
service-account*.json
*serviceAccount*.json
firebase-admin*.json
gcp-service-account*.json
credentials*.json

# Local secret files
secrets.*
*.secret
*.secrets

# ------------------------------
# Logs & temp
# ------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
tmp/
temp/
.cache/
.eslintcache

# ------------------------------
# OS / Editor files
# ------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# ------------------------------
# Test / coverage artifacts
# ------------------------------
coverage/
.nyc_output/

# ------------------------------
# Runtime process files
# ------------------------------
*.pid
*.pid.lock
